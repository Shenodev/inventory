############################################################################
# ShenoInventory API - environment template
#
# Vercel: add these under Project -> Settings -> Environment Variables
# (Production). Never commit a real .env; it is .vercelignored.
# Generate the key once with:  php artisan key:generate --show
############################################################################

APP_NAME="ShenoInventory"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://api.inventory.shenodev.tech

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stderr
LOG_LEVEL=error
LOG_DEPRECATIONS_CHANNEL=null

BCRYPT_ROUNDS=12

# --- Database (Aiven MySQL, TLS required) ---------------------------------
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=22179
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=

# Aiven enforces TLS. Vercel's filesystem is ephemeral, so pass the CA
# base64-encoded (recommended):  base64 -w0 ca.pem
# Keep VERIFY_SERVER_CERT=true whenever the CA is supplied.
MYSQL_ATTR_SSL_CA=
MYSQL_ATTR_SSL_CA_BASE64=
MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=true

# --- CORS (the one browser origin allowed to call the API) ----------------
CORS_ALLOWED_ORIGINS=https://inventory.shenodev.tech

# --- Drivers ---------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=log
